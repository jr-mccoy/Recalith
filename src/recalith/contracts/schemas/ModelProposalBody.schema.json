{
  "$defs": {
    "EvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpanLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mapping": {
          "anyOf": [
            {
              "enum": [
                "tool.exit_code",
                "tool.reported_result",
                "config.exact_value"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping"
        },
        "ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "context"
          ],
          "title": "Relation",
          "type": "string"
        },
        "root_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Root Event Ids",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "relation"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "ProposedOperation": {
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "enum": [
            "update_task",
            "resolve_task_binding",
            "create_episode",
            "revise_episode",
            "propose_claim",
            "assess_claim",
            "attach_evidence",
            "revise_claim",
            "change_claim_status",
            "request_evidence",
            "no_op",
            "create_task",
            "bind_events",
            "record_boundary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "local_ref": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Local Ref",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "reason": {
          "maxLength": 1024,
          "title": "Reason",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "local_ref",
        "kind",
        "payload",
        "reason"
      ],
      "title": "ProposedOperation",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "task",
            "episode",
            "claim",
            "capsule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "SpanLocator": {
      "additionalProperties": false,
      "description": "Unicode code-point offsets into an exact stored string field/chunk.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text_digest": {
          "title": "Text Digest",
          "type": "string"
        }
      },
      "required": [
        "field",
        "start",
        "end",
        "text_digest"
      ],
      "title": "SpanLocator",
      "type": "object"
    }
  },
  "$id": "recalith:contracts/ModelProposalBody",
  "additionalProperties": false,
  "description": "Exactly what a model may return. No usage, actor or provider metadata.",
  "properties": {
    "no_op_reason": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "No Op Reason"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/ProposedOperation"
      },
      "maxItems": 256,
      "title": "Operations",
      "type": "array"
    }
  },
  "required": [
    "operations"
  ],
  "title": "ModelProposalBody",
  "type": "object"
}
