{
  "$defs": {
    "CapsuleSpan": {
      "additionalProperties": false,
      "properties": {
        "context_after": {
          "maxLength": 2048,
          "title": "Context After",
          "type": "string"
        },
        "context_before": {
          "maxLength": 2048,
          "title": "Context Before",
          "type": "string"
        },
        "origin_ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "original_locator": {
          "$ref": "#/$defs/SpanLocator"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_digest": {
          "title": "Text Digest",
          "type": "string"
        }
      },
      "required": [
        "origin_ref",
        "original_locator",
        "text",
        "context_before",
        "context_after",
        "text_digest"
      ],
      "title": "CapsuleSpan",
      "type": "object"
    },
    "OriginEventKey": {
      "additionalProperties": false,
      "properties": {
        "source_event_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Event Key",
          "type": "string"
        },
        "source_namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Namespace",
          "type": "string"
        }
      },
      "required": [
        "source_namespace",
        "source_event_key"
      ],
      "title": "OriginEventKey",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "task",
            "episode",
            "claim",
            "capsule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Empty eligibility lists mean unrestricted within this installation.\n\n``branch_refs`` are recall/origin annotations only, never eligibility.",
      "properties": {
        "branch_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Branch Refs",
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Task Ids",
          "type": "array"
        },
        "workspace_ids": {
          "items": {
            "type": "string"
          },
          "title": "Workspace Ids",
          "type": "array"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "host_session_id": {
          "maxLength": 256,
          "title": "Host Session Id",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "origin_kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Origin Kind",
          "type": "string"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        },
        "source_event_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Event Key",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "source_event_key",
        "host_session_id",
        "origin_kind",
        "source_digest"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SpanLocator": {
      "additionalProperties": false,
      "description": "Unicode code-point offsets into an exact stored string field/chunk.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text_digest": {
          "title": "Text Digest",
          "type": "string"
        }
      },
      "required": [
        "field",
        "start",
        "end",
        "text_digest"
      ],
      "title": "SpanLocator",
      "type": "object"
    }
  },
  "$id": "recalith:contracts/EvidenceCapsule",
  "additionalProperties": false,
  "properties": {
    "capsule_id": {
      "title": "Capsule Id",
      "type": "string"
    },
    "captured_at": {
      "title": "Captured At",
      "type": "string"
    },
    "content_digest": {
      "title": "Content Digest",
      "type": "string"
    },
    "origin_event_key": {
      "$ref": "#/$defs/OriginEventKey"
    },
    "preserved_observation": {
      "additionalProperties": true,
      "title": "Preserved Observation",
      "type": "object"
    },
    "redacted": {
      "title": "Redacted",
      "type": "boolean"
    },
    "root_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Root Event Ids",
      "type": "array"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "source_ref": {
      "$ref": "#/$defs/SourceRef"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/CapsuleSpan"
      },
      "title": "Spans",
      "type": "array"
    }
  },
  "required": [
    "capsule_id",
    "source_ref",
    "origin_event_key",
    "root_event_ids",
    "preserved_observation",
    "spans",
    "captured_at",
    "redacted",
    "content_digest"
  ],
  "title": "EvidenceCapsule",
  "type": "object"
}
