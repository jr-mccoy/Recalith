{
  "$defs": {
    "ProviderCertification": {
      "additionalProperties": false,
      "description": "What a successful probe of this exact route observed (Task 0 / Task 7).\n\n``certified`` is true only for a complete *live* observation with the\noperator's checked background-use eligibility. The route is usable only\nwhile the executable digest, host version, auth route and invocation\nstill equal what was certified; any change requires recertification.",
      "properties": {
        "auth_env_keys": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
            "type": "string"
          },
          "title": "Auth Env Keys",
          "type": "array"
        },
        "certified": {
          "title": "Certified",
          "type": "boolean"
        },
        "certified_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certified At"
        },
        "executable_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable Sha256"
        },
        "expected_api_key_source": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Api Key Source"
        },
        "host_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Version"
        },
        "invocation_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invocation Digest"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "live",
                "request_capture"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "operator_attestation": {
          "default": "unchecked",
          "enum": [
            "checked_eligible",
            "checked_ineligible",
            "unchecked"
          ],
          "title": "Operator Attestation",
          "type": "string"
        },
        "report_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Digest"
        }
      },
      "required": [
        "certified"
      ],
      "title": "ProviderCertification",
      "type": "object"
    }
  },
  "$id": "recalith:contracts/ProviderConfig",
  "additionalProperties": false,
  "description": "Explicit backend/model/auth reference; never chosen because a CLI is on PATH.\n\nLocal to one installation (``.recalith/provider.json``, never tracked):\n``installation_id`` binds it, so a copied configuration is refused.\n``invocation_args`` may contain ``{model}`` and ``{system_prompt}``.\n``nonsecret_env`` holds nonsecret switches for the curator child;\n``network_env_keys`` names managed proxy/TLS keys carried with the route.",
  "properties": {
    "auth_env_keys": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "type": "string"
      },
      "title": "Auth Env Keys",
      "type": "array"
    },
    "auth_route": {
      "enum": [
        "env_api_key",
        "env_oauth_token",
        "env_cloud",
        "api_key_helper"
      ],
      "title": "Auth Route",
      "type": "string"
    },
    "backend": {
      "enum": [
        "claude_cli",
        "json_process"
      ],
      "title": "Backend",
      "type": "string"
    },
    "certification": {
      "$ref": "#/$defs/ProviderCertification"
    },
    "configured_model": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Configured Model",
      "type": "string"
    },
    "executable": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Executable",
      "type": "string"
    },
    "expected_api_key_source": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Api Key Source"
    },
    "installation_id": {
      "title": "Installation Id",
      "type": "string"
    },
    "invocation_args": {
      "items": {
        "type": "string"
      },
      "title": "Invocation Args",
      "type": "array"
    },
    "max_stderr_bytes": {
      "default": 65536,
      "exclusiveMinimum": 0,
      "title": "Max Stderr Bytes",
      "type": "integer"
    },
    "max_wire_stdout_bytes": {
      "default": 262144,
      "exclusiveMinimum": 0,
      "title": "Max Wire Stdout Bytes",
      "type": "integer"
    },
    "network_env_keys": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "type": "string"
      },
      "title": "Network Env Keys",
      "type": "array"
    },
    "nonsecret_env": {
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]{0,127}$": {
          "maxLength": 1024,
          "type": "string"
        }
      },
      "title": "Nonsecret Env",
      "type": "object"
    },
    "provider_id": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "title": "Provider Id",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 120,
      "exclusiveMinimum": 0,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "provider_id",
    "installation_id",
    "backend",
    "executable",
    "configured_model",
    "auth_route",
    "auth_env_keys",
    "invocation_args",
    "certification"
  ],
  "title": "ProviderConfig",
  "type": "object"
}
