{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "description": "Constrained, non-executable applicability predicate (SYSTEM_SPEC §7.4).",
      "properties": {
        "exclude": {
          "default": false,
          "title": "Exclude",
          "type": "boolean"
        },
        "key": {
          "maxLength": 256,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "action_kind",
            "tool",
            "path",
            "environment_equals",
            "version_range",
            "branch_ref"
          ],
          "title": "Kind",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "value": {
          "maxLength": 512,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "DependencyRef": {
      "additionalProperties": false,
      "description": "A registered dependency; a null fingerprint never matches a current value.",
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "config",
            "environment",
            "claim"
          ],
          "title": "Kind",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "title": "DependencyRef",
      "type": "object"
    },
    "EvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpanLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mapping": {
          "anyOf": [
            {
              "enum": [
                "tool.exit_code",
                "tool.reported_result",
                "config.exact_value"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping"
        },
        "ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "context"
          ],
          "title": "Relation",
          "type": "string"
        },
        "root_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Root Event Ids",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "relation"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "PropositionKey": {
      "additionalProperties": false,
      "properties": {
        "predicate": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "subject": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "predicate"
      ],
      "title": "PropositionKey",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "task",
            "episode",
            "claim",
            "capsule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Empty eligibility lists mean unrestricted within this installation.\n\n``branch_refs`` are recall/origin annotations only, never eligibility.",
      "properties": {
        "branch_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Branch Refs",
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Task Ids",
          "type": "array"
        },
        "workspace_ids": {
          "items": {
            "type": "string"
          },
          "title": "Workspace Ids",
          "type": "array"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SpanLocator": {
      "additionalProperties": false,
      "description": "Unicode code-point offsets into an exact stored string field/chunk.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text_digest": {
          "title": "Text Digest",
          "type": "string"
        }
      },
      "required": [
        "field",
        "start",
        "end",
        "text_digest"
      ],
      "title": "SpanLocator",
      "type": "object"
    },
    "SupportedText": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "observed",
            "user_declared",
            "inferred"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "basis"
      ],
      "title": "SupportedText",
      "type": "object"
    }
  },
  "$id": "recalith:contracts/ReviseClaimPayload",
  "additionalProperties": false,
  "properties": {
    "claim_ref": {
      "$ref": "#/$defs/RecordRef"
    },
    "conditions": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conditions"
    },
    "dependencies": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DependencyRef"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dependencies"
    },
    "proposition": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposition"
    },
    "proposition_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/PropositionKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retry_conditions": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SupportedText"
          },
          "maxItems": 8,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Conditions"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "claim_ref"
  ],
  "title": "ReviseClaimPayload",
  "type": "object"
}
