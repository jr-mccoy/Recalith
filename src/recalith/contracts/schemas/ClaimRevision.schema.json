{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "description": "Constrained, non-executable applicability predicate (SYSTEM_SPEC §7.4).",
      "properties": {
        "exclude": {
          "default": false,
          "title": "Exclude",
          "type": "boolean"
        },
        "key": {
          "maxLength": 256,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "action_kind",
            "tool",
            "path",
            "environment_equals",
            "version_range",
            "branch_ref"
          ],
          "title": "Kind",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "value": {
          "maxLength": 512,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "DependencyRef": {
      "additionalProperties": false,
      "description": "A registered dependency; a null fingerprint never matches a current value.",
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "config",
            "environment",
            "claim"
          ],
          "title": "Kind",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "title": "DependencyRef",
      "type": "object"
    },
    "EvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpanLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mapping": {
          "anyOf": [
            {
              "enum": [
                "tool.exit_code",
                "tool.reported_result",
                "config.exact_value"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping"
        },
        "ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "context"
          ],
          "title": "Relation",
          "type": "string"
        },
        "root_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Root Event Ids",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "relation"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "FailureBody": {
      "additionalProperties": false,
      "properties": {
        "action_family_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Action Family Digest"
        },
        "alternative": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupportedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupportedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_supporting_failure_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Supporting Failure Event Id"
        },
        "observed_failure": {
          "$ref": "#/$defs/SupportedText"
        },
        "retry_conditions": {
          "items": {
            "$ref": "#/$defs/SupportedText"
          },
          "title": "Retry Conditions",
          "type": "array"
        }
      },
      "required": [
        "action_family_digest",
        "last_supporting_failure_event_id",
        "observed_failure"
      ],
      "title": "FailureBody",
      "type": "object"
    },
    "ImportOrigin": {
      "additionalProperties": false,
      "properties": {
        "export_digest": {
          "title": "Export Digest",
          "type": "string"
        },
        "source_installation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Installation Id"
        },
        "source_project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Project Id"
        },
        "source_record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "source_project_id",
        "source_installation_id",
        "source_record_id",
        "source_revision",
        "export_digest"
      ],
      "title": "ImportOrigin",
      "type": "object"
    },
    "ModelProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "configured_model": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Configured Model",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "prompt_digest": {
          "title": "Prompt Digest",
          "type": "string"
        },
        "prompt_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Prompt Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "resolved_model": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved Model"
        }
      },
      "required": [
        "provider_id",
        "configured_model",
        "resolved_model",
        "adapter_version",
        "prompt_id",
        "prompt_digest",
        "job_id"
      ],
      "title": "ModelProvenance",
      "type": "object"
    },
    "ProcedureBody": {
      "additionalProperties": false,
      "properties": {
        "expected_outcomes": {
          "items": {
            "$ref": "#/$defs/SupportedText"
          },
          "title": "Expected Outcomes",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/SupportedText"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/SupportedText"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "$ref": "#/$defs/SupportedText"
          },
          "title": "Stop Conditions",
          "type": "array"
        },
        "successful_episode_ids": {
          "items": {
            "type": "string"
          },
          "title": "Successful Episode Ids",
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "title": "ProcedureBody",
      "type": "object"
    },
    "PropositionKey": {
      "additionalProperties": false,
      "properties": {
        "predicate": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "subject": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "predicate"
      ],
      "title": "PropositionKey",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "task",
            "episode",
            "claim",
            "capsule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "ReviewAssessment": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "title": "Batch Id",
          "type": "string"
        },
        "candidate_ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "evidence_digest": {
          "title": "Evidence Digest",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "objections": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "title": "Objections",
          "type": "array"
        },
        "prompt_digest": {
          "title": "Prompt Digest",
          "type": "string"
        },
        "proposal_digest": {
          "title": "Proposal Digest",
          "type": "string"
        },
        "review_job_id": {
          "title": "Review Job Id",
          "type": "string"
        },
        "reviewed_at": {
          "title": "Reviewed At",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "supported",
            "revise",
            "reject"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "review_job_id",
        "batch_id",
        "candidate_ref",
        "proposal_digest",
        "evidence_digest",
        "prompt_digest",
        "verdict",
        "objections",
        "reviewed_at"
      ],
      "title": "ReviewAssessment",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Empty eligibility lists mean unrestricted within this installation.\n\n``branch_refs`` are recall/origin annotations only, never eligibility.",
      "properties": {
        "branch_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Branch Refs",
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Task Ids",
          "type": "array"
        },
        "workspace_ids": {
          "items": {
            "type": "string"
          },
          "title": "Workspace Ids",
          "type": "array"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SpanLocator": {
      "additionalProperties": false,
      "description": "Unicode code-point offsets into an exact stored string field/chunk.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text_digest": {
          "title": "Text Digest",
          "type": "string"
        }
      },
      "required": [
        "field",
        "start",
        "end",
        "text_digest"
      ],
      "title": "SpanLocator",
      "type": "object"
    },
    "SupportedText": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "observed",
            "user_declared",
            "inferred"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "basis"
      ],
      "title": "SupportedText",
      "type": "object"
    }
  },
  "$id": "recalith:contracts/ClaimRevision",
  "additionalProperties": false,
  "properties": {
    "basis": {
      "enum": [
        "observed",
        "user_declared",
        "inferred"
      ],
      "title": "Basis",
      "type": "string"
    },
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "conditions": {
      "items": {
        "$ref": "#/$defs/Condition"
      },
      "title": "Conditions",
      "type": "array"
    },
    "context": {
      "items": {
        "$ref": "#/$defs/EvidenceLink"
      },
      "title": "Context",
      "type": "array"
    },
    "contradicts": {
      "items": {
        "$ref": "#/$defs/EvidenceLink"
      },
      "title": "Contradicts",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/DependencyRef"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "effective_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective From"
    },
    "effective_until": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective Until"
    },
    "evidence_availability": {
      "enum": [
        "available",
        "capsule_only",
        "expired",
        "redacted"
      ],
      "title": "Evidence Availability",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureBody"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "freshness": {
      "enum": [
        "current",
        "needs_revalidation",
        "unknown"
      ],
      "title": "Freshness",
      "type": "string"
    },
    "installation_id": {
      "title": "Installation Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "fact",
        "decision",
        "preference",
        "failure_lesson",
        "procedure"
      ],
      "title": "Kind",
      "type": "string"
    },
    "last_supported_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Supported At"
    },
    "model_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImportOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "procedure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProcedureBody"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "proposition": {
      "maxLength": 4096,
      "title": "Proposition",
      "type": "string"
    },
    "proposition_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/PropositionKey"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "review_assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_class": {
      "enum": [
        "volatile",
        "stable"
      ],
      "title": "Review Class",
      "type": "string"
    },
    "review_due_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Due At"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "status": {
      "enum": [
        "candidate",
        "active",
        "disputed",
        "superseded",
        "invalidated",
        "archived",
        "quarantined",
        "forgotten"
      ],
      "title": "Status",
      "type": "string"
    },
    "strength": {
      "enum": [
        "weak",
        "supported",
        "corroborated"
      ],
      "title": "Strength",
      "type": "string"
    },
    "superseded_by": {
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Superseded By",
      "type": "array"
    },
    "supersedes": {
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Supersedes",
      "type": "array"
    },
    "supports": {
      "items": {
        "$ref": "#/$defs/EvidenceLink"
      },
      "title": "Supports",
      "type": "array"
    }
  },
  "required": [
    "claim_id",
    "project_id",
    "installation_id",
    "revision",
    "kind",
    "proposition",
    "proposition_key",
    "basis",
    "strength",
    "status",
    "freshness",
    "evidence_availability",
    "recorded_at",
    "review_class"
  ],
  "title": "ClaimRevision",
  "type": "object"
}
