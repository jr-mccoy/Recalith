{
  "$defs": {
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "task",
            "episode",
            "claim",
            "capsule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "RecordRef",
      "type": "object"
    }
  },
  "$id": "recalith:contracts/ChangeClaimStatusPayload",
  "additionalProperties": false,
  "properties": {
    "claim_ref": {
      "$ref": "#/$defs/RecordRef"
    },
    "replacement_local_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replacement Local Ref"
    },
    "replacement_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "enum": [
        "disputed",
        "superseded",
        "invalidated",
        "archived"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "claim_ref",
    "status"
  ],
  "title": "ChangeClaimStatusPayload",
  "type": "object"
}
