{
  "$defs": {
    "EvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpanLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mapping": {
          "anyOf": [
            {
              "enum": [
                "tool.exit_code",
                "tool.reported_result",
                "config.exact_value"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping"
        },
        "ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "context"
          ],
          "title": "Relation",
          "type": "string"
        },
        "root_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Root Event Ids",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "relation"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "PendingAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/SupportedText"
        },
        "state": {
          "enum": [
            "proposed",
            "running",
            "awaiting_result",
            "finished",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "action_id",
        "description",
        "state"
      ],
      "title": "PendingAction",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "task",
            "episode",
            "claim",
            "capsule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Empty eligibility lists mean unrestricted within this installation.\n\n``branch_refs`` are recall/origin annotations only, never eligibility.",
      "properties": {
        "branch_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Branch Refs",
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Task Ids",
          "type": "array"
        },
        "workspace_ids": {
          "items": {
            "type": "string"
          },
          "title": "Workspace Ids",
          "type": "array"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SpanLocator": {
      "additionalProperties": false,
      "description": "Unicode code-point offsets into an exact stored string field/chunk.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text_digest": {
          "title": "Text Digest",
          "type": "string"
        }
      },
      "required": [
        "field",
        "start",
        "end",
        "text_digest"
      ],
      "title": "SpanLocator",
      "type": "object"
    },
    "SupportedText": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "observed",
            "user_declared",
            "inferred"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "basis"
      ],
      "title": "SupportedText",
      "type": "object"
    }
  },
  "$id": "recalith:contracts/TaskState",
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "$ref": "#/$defs/SupportedText"
      },
      "title": "Blockers",
      "type": "array"
    },
    "child_task_ids": {
      "items": {
        "type": "string"
      },
      "title": "Child Task Ids",
      "type": "array"
    },
    "completion_basis": {
      "anyOf": [
        {
          "$ref": "#/$defs/SupportedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/SupportedText"
      },
      "title": "Constraints",
      "type": "array"
    },
    "installation_id": {
      "title": "Installation Id",
      "type": "string"
    },
    "known_results": {
      "items": {
        "$ref": "#/$defs/SupportedText"
      },
      "title": "Known Results",
      "type": "array"
    },
    "last_activity_at": {
      "title": "Last Activity At",
      "type": "string"
    },
    "next_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/SupportedText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "objective": {
      "anyOf": [
        {
          "$ref": "#/$defs/SupportedText"
        },
        {
          "type": "null"
        }
      ]
    },
    "open_questions": {
      "items": {
        "$ref": "#/$defs/SupportedText"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "pending_actions": {
      "items": {
        "$ref": "#/$defs/PendingAction"
      },
      "title": "Pending Actions",
      "type": "array"
    },
    "plan": {
      "items": {
        "$ref": "#/$defs/SupportedText"
      },
      "title": "Plan",
      "type": "array"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "redirect_task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Redirect Task Id"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "session_ids": {
      "items": {
        "type": "string"
      },
      "title": "Session Ids",
      "type": "array"
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "completed",
        "abandoned",
        "linked"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "title": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "project_id",
    "installation_id",
    "revision",
    "status",
    "title",
    "objective",
    "updated_at",
    "last_activity_at"
  ],
  "title": "TaskState",
  "type": "object"
}
